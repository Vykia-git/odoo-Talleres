<odoo>

    <record id="action_report_workshop_order" model="ir.actions.report">
        <field name="name">Orden de trabajo</field>
        <field name="model">workshop.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">workshop_management.report_workshop_order</field>
        <field name="report_file">workshop_management.report_workshop_order</field>
        <field name="print_report_name">'Orden %s' % (object.name)</field>
        <!-- Aparece en el desplegable "Imprimir" de la propia orden -->
        <field name="binding_model_id" ref="model_workshop_order" />
        <field name="binding_type">report</field>
    </record>

</odoo>
