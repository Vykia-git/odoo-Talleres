<odoo>

    <!-- Numeración de órdenes: B001, B002... B125
         El prefijo y el relleno son editables en Ajustes > Técnico > Secuencias
         sin tocar código. noupdate="1" evita que una actualización del módulo
         reinicie el contador en producción. -->
    <data noupdate="1">
        <record id="seq_workshop_order" model="ir.sequence">
            <field name="name">Orden de taller</field>
            <field name="code">workshop.order</field>
            <field name="prefix">B</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False" />
        </record>
    </data>

</odoo>
