<odoo>

    <record id="res_partner_view_form_workshop" model="ir.ui.view">
        <field name="name">res.partner.form.workshop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_workshop_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    groups="workshop_management.group_workshop_user"
                    invisible="workshop_order_count == 0"
                >
                    <field
                        name="workshop_order_count"
                        widget="statinfo"
                        string="Órdenes de taller"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Clientes del taller: vista simplificada, sin el resto del CRM -->
    <record id="workshop_partner_action" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_is_company': False}</field>
    </record>

</odoo>
