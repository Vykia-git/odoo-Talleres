<odoo>

    <record id="module_category_workshop" model="ir.module.category">
        <field name="name">Taller</field>
        <field name="description">Gestión de taller mecánico</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 19: res.groups ya no tiene category_id. Los grupos se agrupan
         en el formulario de usuario mediante res.groups.privilege, que es
         quien apunta a la ir.module.category. -->
    <record id="res_groups_privilege_workshop" model="res.groups.privilege">
        <field name="name">Taller</field>
        <field name="category_id" ref="module_category_workshop" />
        <field name="sequence">10</field>
    </record>

    <record id="group_workshop_user" model="res.groups">
        <field name="name">Operario</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop" />
        <field name="sequence">10</field>
        <field name="comment">Puede registrar ingresos, editar y cerrar órdenes.</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop" />
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_workshop_user'))]" />
        <field name="comment">Además, puede anular órdenes y configurar el módulo.</field>
    </record>

    <!-- El administrador del sistema arranca como Responsable de taller -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('group_workshop_manager'))]" />
    </record>

    <!-- Aislamiento multicompañía -->
    <record id="workshop_order_company_rule" model="ir.rule">
        <field name="name">Orden de taller: multicompañía</field>
        <field name="model_id" ref="model_workshop_order" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="workshop_vehicle_company_rule" model="ir.rule">
        <field name="name">Vehículo de taller: multicompañía</field>
        <field name="model_id" ref="model_workshop_vehicle" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
