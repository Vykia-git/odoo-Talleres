[options]
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons,/mnt/oca-addons/web,/mnt/oca-addons/account-financial-reporting,/mnt/oca-addons/mis-builder,/mnt/oca-addons/reporting-engine,/mnt/oca-addons/server-tools,/mnt/oca-addons/project,/mnt/oca-addons/knowledge,/mnt/oca-addons/hr,/mnt/oca-addons/server-ux,/mnt/oca-addons/calendar,/mnt/oca-addons/dms,/mnt/oca-addons/queue,/mnt/oca-addons/l10n-spain,/mnt/oca-addons/contract,/mnt/oca-addons/helpdesk,/mnt/oca-addons/account-financial-tools,/mnt/oca-addons/account-reconcile,/mnt/oca-addons/account-payment,/mnt/oca-addons/bank-payment,/mnt/oca-addons/account-budgeting,/mnt/oca-addons/account-closing,/mnt/third-addons
data_dir = /var/lib/odoo
db_host = db
db_port = 5432
db_user = odoo
; Debe coincidir con DB_PASSWORD de .env
db_password = CAMBIAME
; Master password de Odoo (gestor de bases de datos).
; Se fija desde http://localhost:8069/web/database/manager
; -> Set Master Password; Odoo escribe aqui el hash.
admin_passwd = CAMBIAME


; El configurador de sitio web encadena dos recargas de registry (tema +
; modulos de features) y varias llamadas IAP con timeout. Con los limites por
; defecto (cpu 60 s / real 120 s) el worker muere a media faena y deja paginas
; duplicadas y la home vacia.
limit_time_cpu = 600
limit_time_real = 1200
limit_time_real_cron = 1200
